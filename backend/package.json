{
  "name": "aunpayroll-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AUN Payroll — backend API (Express + MongoDB Atlas, Excel parsing, PDF pay advices, email delivery)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:check": "node scripts/checkMongo.js",
    "admin:create": "node scripts/adminCli.js create",
    "admin:reset-password": "node scripts/adminCli.js reset-password",
    "db:init": "node -e \"const db=require('./models/db');db.bootstrap().then(async()=>{console.log('Database initialised (collections, indexes).');await db.disconnect();process.exit(0)}).catch(e=>{console.error(require('./config/mongo').redact(e.message));process.exit(1)})\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.10.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.12",
    "puppeteer": "^25.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
