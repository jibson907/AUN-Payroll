# ─────────────────────────────────────────────────────────────
#  AUN Payroll — BACKEND environment.  Copy to `.env` and edit.
#  NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

PORT=5000

# ── MongoDB Atlas ────────────────────────────────────────────
# Full connection string from Atlas → Connect → Drivers, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/AUNpayroll?retryWrites=true&w=majority
# Use a dedicated database user with readWrite on this database only.
# URL-encode special characters in the password (@ → %40, # → %23, etc.).
MONGODB_URI=
# Optional: database name, if not given in the URI path above.
MONGODB_DB_NAME=AUNpayroll
# Optional: only if connecting fails with "querySrv ECONNREFUSED" (local
# router/DNS refuses SRV lookups). Comma-separated public resolvers.
MONGODB_DNS_SERVERS=

# ── Authentication ───────────────────────────────────────────
# Long random value, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Session length in hours (1–24). Sessions are HttpOnly cookies.
SESSION_TTL_HOURS=8
# true = cookies only sent over HTTPS. Must be true in production;
# leave false for http://localhost development.
COOKIE_SECURE=false
# Number of reverse proxies (nginx, load balancer) in front of the API.
# 0 when the API is reached directly. Wrong values weaken IP rate limiting.
TRUST_PROXY=0
# Sign-in lockout: failed attempts before pausing, and pause length.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Admin accounts are NOT configured here. Create the first one with:
#   npm run admin:create

# ── Email / SMTP (Google Workspace: see README) ─────────────
# Until these are set, sending is disabled (nothing is marked as sent).
# payroll@aun.edu.ng via Google: host smtp.gmail.com, port 465, SMTP_SECURE=true,
# password = a 16-character Google App Password (or use smtp-relay.gmail.com).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="AUN Payroll <payroll@aun.edu.ng>"
# Optional monitored inbox for staff replies
EMAIL_REPLY_TO=
# Controlled delivery: emails per batch, parallel sends, pause between batches (ms)
EMAIL_BATCH_SIZE=50
EMAIL_CONCURRENCY=2
EMAIL_BATCH_PAUSE_MS=30000

# ── Uploads ─────────────────────────────────────────────────
MAX_UPLOAD_MB=10
MAX_ROWS=5000
UPLOAD_LIMIT_PER_15MIN=20

# ── Production ──────────────────────────────────────────────
# NODE_ENV=production also turns on SERVE_FRONTEND (serves frontend/dist)
# and requires COOKIE_SECURE=true (HTTPS).
NODE_ENV=development

# ── CORS: the React dev server origin ────────────────────────
FRONTEND_URL=http://localhost:5173
