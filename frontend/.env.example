# Frontend settings are public (they end up in the browser bundle).
# Never put MONGODB_URI, JWT_SECRET, SMTP_* or any other backend secret here.
#
# .env.production  → `npm run build`  → https://aun.edu.ng/payrol/
#   VITE_BASE_PATH=/payrol
#   VITE_API_BASE_URL=/payrol/api
# .env.development → `npm run dev`    → http://localhost:5173/
#   VITE_BASE_PATH=
#   VITE_API_BASE_URL=/api
#
# If VITE_API_BASE_URL is empty, the API defaults to <base path>/api.
VITE_BASE_PATH=
VITE_API_BASE_URL=
